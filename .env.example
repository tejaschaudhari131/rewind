# Meta Model API Configuration (https://dev.meta.ai)
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_VOICE_WS_URL=wss://api.meta.ai/v1/asr/realtime

# Default Reasoning / State Compiler Model
# Use muse-spark-1.3-contributor ($0.10/M in, $0.20/M out, covered by promotional credits) for dev/testing,
# or muse-wonder-1.0 for final high-depth compilation & native Computer Use (CUA) CAD inspection.
REWIND_COMPILER_MODEL=muse-spark-1.3-contributor

# Open-Weight Endpoints ($10K Open Weight Bonus Lane)
# Modal H100 deployment serving facebook/Muse-Glimmer-30B with container memory snapshotting
MODAL_GLIMMER_ENDPOINT=
# Baseten hackathon deployment serving meta-models/muse-spark-open-1026
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_SPARK_MODEL=meta-models/muse-spark-open-1026

# Optional Residential Egress Proxy (if running from datacenter egress)
HTTP_PROXY=
HTTPS_PROXY=
